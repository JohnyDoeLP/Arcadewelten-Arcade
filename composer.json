{
	"name": "arcadewelten/arcade",
	"type": "phpbb-extension",
	"description": "Self-hosted arcade for phpBB 3.3: game list, highscores and champions. Supports IBPro, IBPro v3, Activity Mod and HTML5 games, Flash via self-hosted Ruffle. No external connections, no ads.",
	"homepage": "https://arcadewelten.eu",
	"version": "0.18.0-beta",
	"time": "2026-11-09",
	"keywords": [
		"phpbb",
		"extension",
		"arcade",
		"games",
		"highscores",
		"ruffle"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Patrick Overmann",
			"homepage": "https://arcadewelten.eu",
			"role": "Lead Developer"
		}
	],
	"require": {
		"php": ">=8.2",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "Arcadewelten Arcade",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
		"version-check": {
			"host": "raw.githubusercontent.com",
			"directory": "/JohnyDoeLP/Arcadewelten-Arcade/main",
			"filename": "version.json",
			"ssl": true
		}
	}
}
